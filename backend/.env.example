# Copie para .env (que fica fora do Git) e ajuste. Valores reais nunca vão ao repositório.
# Os bancos (MYSQL_URL, MONGO_URL) entram na R0 parte 7; o JWT e o Resend, na R1.

NODE_ENV=development
PORT=3001

# Origens permitidas no CORS, separadas por vírgula (nunca "*").
CORS_ORIGINS=http://localhost:5173
